    <td valign=top>
    <table>
        <tr>
            <td class="BlackTextBold">
                AccountID
            </td>
            
            <td>
                            <asp:TextBox ID="txtUserName" CssClass="inputtext" Enabled=false Width=100 runat="server"></asp:TextBox>
        
            </td>
            
              <td Class="BlackTextBold" >
                Connection
            </td>
            
            <td>
                                <asp:DropDownList CssClass="inputtext" Enabled=false  ID="cmbConnection" runat="server">
                                <asp:ListItem Value="demo">Demo</asp:ListItem>
                                <asp:ListItem Value="real">Real</asp:ListItem>
                                </asp:DropDownList>
        
            </td>
            
            
             <td>
                 
                

        
            </td>
            
            
        </tr>
        
        
        
         <tr>
            <td Class="BlackTextBold" >
                Password
            </td>
            
            <td>
                            <asp:TextBox ID="txtPassword" CssClass="inputtext"  Enabled=false Width=100 
                                runat="server" TextMode="Password" ></asp:TextBox>
        
            </td>
            
              <td>
                
            </td>
            
            <td>
                                
        
            </td>
            
            
             <td>
                 
                 
        
            </td>
            
            
