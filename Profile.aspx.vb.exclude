Imports System.Data.OleDb

Partial Class Profile2
    Inherits System.Web.UI.Page

    Private passStatus As String
    Private proofStatus As String
    Private isCreditCardExist As Boolean
    Private isCreditCardValid As Boolean

    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load
        If (Session("UserID") = Nothing) Then
            Response.Redirect("Login.aspx?redirect=profile")
        End If

        txtUserID.Text = Session("UserID")

        Dim opExec As New rpchost.cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select * from MembersForex where ID = " & Session("UserID"))
        Try

            If reader.HasRows = True Then

                reader.Read()

                If (Not IsDBNull(reader("FirstName"))) Then txtFirst.Text = reader("FirstName")
                If (Not IsDBNull(reader("LastName"))) Then txtLast.Text = reader("LastName")
                If (Not IsDBNull(reader("FatherName"))) Then txtFatherName.Text = reader("FatherName")
                If (Not IsDBNull(reader("Email"))) Then txtEmail.Text = reader("Email")
                If (Not IsDBNull(reader("Phone"))) Then txtMobile.Text = reader("Phone")
                If (Not IsDBNull(reader("Pwd"))) Then txtPass.Text = reader("Pwd")
                If (Not IsDBNull(reader("PerfectMoney"))) Then txtPerfectMoney.Text = reader("PerfectMoney")
                If (Not IsDBNull(reader("Payeer"))) Then txtPayeer.Text = reader("Payeer")
                If (Not IsDBNull(reader("BitcoinWallet"))) Then txtBitcoin.Text = reader("BitcoinWallet")

                If (Not IsDBNull(reader("BankHolderName"))) Then txtHolder.Text = reader("BankHolderName")
                If (Not IsDBNull(reader("Swift"))) Then txtSwift.Text = reader("Swift")
                If (Not IsDBNull(reader("BankName"))) Then txtBankname.Text = reader("BankName")
                If (Not IsDBNull(reader("IBAN"))) Then txtIBAN.Text = reader("IBAN")
                If (Not IsDBNull(reader("AccountNum"))) Then txtAccountNumber.Text = reader("AccountNum")
                If (Not IsDBNull(reader("BankCountry"))) Then ddlCountry.SelectedValue = reader("BankCountry")

            End If

        Catch ex As Exception
            Response.Redirect(ex.Message)
        Finally
            opExec.closeConnection()
        End Try


        Dim opExec1 As New rpchost.cs_Operation
        Dim reader1 As OleDbDataReader = opExec1.rdGetReader("select * from Verification where UserID = " & Session("UserID"))
        Try

            If reader1.HasRows = True Then

                reader1.Read()

                If (Not IsDBNull(reader1("PassportStatus"))) Then
                    lblPassport.Text = reader1("PassportStatus")
                    passStatus = reader1("PassportStatus")
                End If

                If (Not IsDBNull(reader1("ProofStatus"))) Then
                    lblProof.Text = reader1("ProofStatus")
                    proofStatus = reader1("ProofStatus")
                End If

                If (lblPassport.Text.Contains("Rejected") = False And lblPassport.Text <> "") Then MyFilePassport.Disabled = True

                If (lblProof.Text.Contains("Rejected") = False And lblProof.Text <> "") Then MyFileProofOfAddress.Disabled = True

            Else

                passStatus = ""
                proofStatus = ""

                MyFilePassport.Disabled = False
                MyFileProofOfAddress.Disabled = False

                Dim opExecVerify As New rpchost.cs_Operation
                Dim sql As String = "insert into Verification (UserID) values (" & Session("UserID") & ")"
                opExecVerify.ExecuteSql(sql)
                opExecVerify.closeConnection()


            End If

        Catch ex As Exception
            Response.Redirect(ex.Message)
        Finally
            opExec1.closeConnection()
        End Try



        Dim opExecCredit As New rpchost.cs_Operation
        Dim readerCredit As OleDbDataReader = opExecCredit.rdGetReader("select * from CreditCard where UserID = " & Session("UserID"))
        Try

            If readerCredit.HasRows = True Then

                readerCredit.Read()
                isCreditCardExist = True

                If (IsDBNull(readerCredit("CardNumber")) Or readerCredit("CardNumber") = "" Or IsDBNull(readerCredit("CardHolderName")) Or readerCredit("CardHolderName") = "" Or IsDBNull(readerCredit("ExpiryMonth")) Or readerCredit("ExpiryMonth") = "0" Or IsDBNull(readerCredit("ExpiryYear")) Or readerCredit("ExpiryYear") = "0" Or IsDBNull(readerCredit("CVV")) Or readerCredit("CVV") = "0") Then
                    isCreditCardValid = False
                    MyFilePassport.Disabled = True
                    MyFileProofOfAddress.Disabled = True
                    lblPassport.Text = "Please fill your Credit Card data"
                    lblProof.Text = "Please fill your Credit Card data"
                Else
                    isCreditCardValid = True
                    MyFilePassport.Disabled = False
                    MyFileProofOfAddress.Disabled = False
                End If

                If (Not IsDBNull(readerCredit("CardNumber"))) Then txtCardNumber.Text = readerCredit("CardNumber")
                If (Not IsDBNull(readerCredit("ExpiryMonth"))) Then txtExpiryMonth.Text = readerCredit("ExpiryMonth")
                If (Not IsDBNull(readerCredit("ExpiryYear"))) Then txtExpiryYear.Text = readerCredit("ExpiryYear")
                If (Not IsDBNull(readerCredit("CardHolderName"))) Then txtCardHolderName.Text = readerCredit("CardHolderName")
                If (Not IsDBNull(readerCredit("CVV"))) Then txtCVV.Text = readerCredit("CVV")

            Else
                isCreditCardExist = False

                lblPassport.Text = "Please fill your Credit Card data"
                lblProof.Text = "Please fill your Credit Card data"
                MyFilePassport.Disabled = True
                MyFileProofOfAddress.Disabled = True

            End If

        Catch ex As Exception
            Response.Redirect(ex.Message)
        Finally
            opExecCredit.closeConnection()
        End Try

    End Sub

    Protected Sub btnSubmit_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles btnSubmit.Click

        If (Session("UserID") = Nothing) Then
            Response.Redirect("Login.aspx?redirect=profile")
        End If


        If (isEmailExist(Request("txtEmail"))) Then

            Response.Write("<script>alert('Email already exist')</script>")
            Return
        End If
        If (Not Request("txtEmail").Contains("@") Or Not Request("txtEmail").Contains(".com")) Then
            Response.Write("<script>alert('Not valid Email')</script>")
            Return
        End If

        If (Trim(Request("txtPass")).Length() < 6) Then

            Response.Write("<script>alert('Password must be at least 6 digits')</script>")
            Return
        End If

        If (Trim(Request("txtExpiryMonth")).Length() > 0) Then
            If (Not IsNumeric(Trim(Request("txtExpiryMonth")))) Then
                Response.Write("<script>alert('Credit Card Expiry month should be numeric')</script>")
                Return
            End If
            If (IsNumeric(Trim(Request("txtExpiryMonth"))) And (Trim(Request("txtExpiryMonth")) < 1 Or Trim(Request("txtExpiryMonth")) > 12)) Then
                Response.Write("<script>alert('Credit Card Expiry month should be between 1 and 12')</script>")
                Return
            End If


        End If

        If (Trim(Request("txtExpiryYear")).Length() > 0) Then
            If (Not IsNumeric(Trim(Request("txtExpiryYear")))) Then
                Response.Write("<script>alert('Credit Card Expiry year should be numeric')</script>")
                Return
            End If
            If (IsNumeric(Trim(Request("txtExpiryYear"))) And (Trim(Request("txtExpiryYear")) < 2018 Or Trim(Request("txtExpiryYear")) > 2030)) Then
                Response.Write("<script>alert('Credit Card Expiry year should be between 2018 and 2030')</script>")
                Return
            End If


        End If


        Dim opExec As New rpchost.cs_Operation
        Try
            Dim sql As String = "update membersforex set firstname='" & Trim(Request("txtFirst")) & "',lastname='" & Trim(Request("txtLast")) & "',Fathername='" & Trim(Request("txtFatherName")) & "',email='" & Trim(Request("txtEmail")) & "',Phone='" & Trim(Request("txtMobile")) & "',pwd='" & Trim(Request("txtPass")) & "',PerfectMoney='" & Trim(Request("txtPerfectMoney")) & "',Payeer='" & Trim(Request("txtPayeer")) & "',BitcoinWallet = '" & Trim(Request("txtBitcoin")) & "' ,BankHolderName = '" & Trim(Request("txtHolder")) & "',Swift = '" & Trim(Request("txtSwift")) & "',BankName = '" & Trim(Request("txtBankname")) & "',IBAN = '" & Trim(Request("txtIBAN")) & "',AccountNum = '" & Trim(Request("txtAccountNumber")) & "',BankCountry = '" & Request("ddlCountry") & "' where ID = " & Session("UserID")
            opExec.ExecuteSql(sql)
            opExec.closeConnection()


            Response.Write("<script>alert('Successfully updated')</script>")


        Catch ex As Exception
            lblMess.Text = "Error while registration"
        Finally
            opExec.closeConnection()
        End Try


        Dim opExecCredit As New rpchost.cs_Operation
        Try
            Dim sql As String

            If (isCreditCardExist) Then
                sql = "update CreditCard set CardNumber='" & Trim(Request("txtCardNumber")) & "',ExpiryMonth=" & IIf(Trim(Request("txtExpiryMonth")) = "", 0, Trim(Request("txtExpiryMonth"))) & ",ExpiryYear=" & IIf(Trim(Request("txtExpiryYear")) = "", 0, Trim(Request("txtExpiryYear"))) & ",CardHolderName='" & Trim(Request("txtCardHolderName")) & "',CVV=" & IIf(Trim(Request("txtCVV")) = "", 0, Trim(Request("txtCVV"))) & " where UserID = " & Session("UserID")
            Else
                sql = "insert into CreditCard (UserID,CardNumber,ExpiryMonth,ExpiryYear,CardHolderName,CVV) values (" & Session("UserID") & ",'" & Trim(Request("txtCardNumber")) & "'," & IIf(Trim(Request("txtExpiryMonth")) = "", 0, Trim(Request("txtExpiryMonth"))) & "," & IIf(Trim(Request("txtExpiryYear")) = "", 0, Trim(Request("txtExpiryYear"))) & ",'" & Trim(Request("txtCardHolderName")) & "'," & IIf(Trim(Request("txtCVV")) = "", 0, Trim(Request("txtCVV"))) & " )"
            End If

            opExecCredit.ExecuteSql(sql)
            opExecCredit.closeConnection()

        Catch ex As Exception
            lblMess.Text = "Error while registration"
        Finally
            opExecCredit.closeConnection()
        End Try

        If Not MyFilePassport.PostedFile Is Nothing Then

            If (MyFilePassport.PostedFile.ContentLength <> 0) Then
                Dim fnPass As String = System.IO.Path.GetFileName(MyFilePassport.PostedFile.FileName)

                MyFilePassport.PostedFile.SaveAs(Server.MapPath("Verification\\Pass-" & Session("UserID") & "-" & fnPass))

                Dim sql As String = "update Verification set DateSent='" & Logger.GenerateTimeZone("Eastern Standard Time") & "', PassportFile= 'Pass-" & Session("UserID") & "-" & fnPass & "' , PassportStatus= 'In Process' "
                opExec.ExecuteSql(sql)
                opExec.closeConnection()

            End If

        End If


        If Not MyFileProofOfAddress.PostedFile Is Nothing Then

            If (MyFileProofOfAddress.PostedFile.ContentLength <> 0) Then


                Dim fnProof As String = System.IO.Path.GetFileName(MyFileProofOfAddress.PostedFile.FileName)

                MyFileProofOfAddress.PostedFile.SaveAs(Server.MapPath("Verification\\Proof-" & Session("UserID") & fnProof))

                Dim sql As String = "update Verification set DateSent='" & Logger.GenerateTimeZone("Eastern Standard Time") & "', ProofFile= 'Proof-" & Session("UserID") & "-" & fnProof & "', ProofStatus='In Process' "
                opExec.ExecuteSql(sql)
                opExec.closeConnection()

            End If
        End If

        Response.Redirect("profile.aspx")


    End Sub


    Public Function isEmailExist(ByVal Email As String) As Boolean

        If (Session("UserID") = Nothing) Then
            Response.Redirect("Login.aspx?redirect=profile")
        End If

        Dim str As String = ""
        Dim opExec As New rpchost.cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select * from MembersForex where Email = '" & Email & "' and ID <> " & Session("UserID"))
        Try

            If reader.HasRows = True Then

                Return True

            Else

                Return False

            End If

        Catch ex As Exception
            Response.Write("ERROR")
        Finally
            opExec.closeConnection()
        End Try

        Return True

    End Function



End Class
