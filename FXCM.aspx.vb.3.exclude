    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load

        Call GetAccount()

    End Sub




    Public Function Marquee() As String

        Dim strMarquee As String = ""

        Dim opExec As New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select * from News")
        Try

            If reader.HasRows = True Then

                While reader.Read()
                    strMarquee = strMarquee & " - " & reader("Description")
                End While

            End If

            Return strMarquee

        Catch ex As Exception

        Finally

            reader.Close()
        End Try

    End Function






    Private Function GetAccount() As String

        GetAccount = ""

        If (txtRpcUserID.Text = "" And txtRpcPwd.Text = "") Then


            Dim opExec As New cs_Operation
            opExec = New cs_Operation
            Dim reader As OleDbDataReader = opExec.rdGetReader("select * from AccountInfo")
            Try
                If reader.HasRows = True Then

                    reader.Read()
                    txtPassword.Attributes.Add("value", reader("Pwd"))
                    txtUserName.Text = reader("UserID")
                    txtPassword.Text = reader("Pwd")
                    cmbConnection.Text = reader("Connection")
                    txtRpcUserID.Text = reader("RpcUserID")
                    txtRpcPwd.Attributes.Add("value", reader("RpcPwd"))
                    GetAccount = reader("UserID")

                End If



            Catch ex As Exception
                Response.Write(ex.Message)
            Finally
                opExec.closeConnection()
                'reader.Close()
            End Try


        End If


    End Function

    Protected Sub cmdLogin_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles cmdLogin.Click



        cmdLogin.Enabled = False
        cmdLogin.UpdateAfterCallBack = True
        cmdLogin.DataBind()

        If Login((Me.txtUserName.Text), (Me.txtPassword.Text), "http://www.fxcorporate.com", (Me.cmbConnection.Text), desk) = False Then
            Exit Sub
        Else
            isLogged = True
            Timer1.Enabled = True

            lblClosedPos.Visible = True
            lblOpenPos.Visible = True



        End If


        'Disable and enable boxes after login

        Me.txtUserName.Enabled = False
        Me.txtPassword.Enabled = False
        Me.txtRpcUserID.Enabled = False
        Me.txtRpcPwd.Enabled = False
        Me.cmbConnection.Enabled = False

        Me.cmdLogOut.Enabled = True
        Me.cmbAccount.Enabled = True
        Me.cmbAmountK.Enabled = True


        'Try


        '    maxtrade = desk.GetSystemProperty("MAX_QUANTITY")
        '    minTrail = desk.GetSystemProperty("TRAILING_STOP_MIN")
        '    maxTrail = desk.GetSystemProperty("TRAILING_STOP_MAX")


        'Catch ex As Exception

        'End Try

        LoginCompleted = True




    End Sub

