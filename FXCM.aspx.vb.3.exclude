    Sub updateData()

        txtOpenedPips.Text = getOpenedPips()
        txtOpenedPips.UpdateAfterCallBack = True
        txtOpenedPips.DataBind()

        txtClosedPips.Text = getClosedPips()
        txtClosedPips.UpdateAfterCallBack = True
        txtClosedPips.DataBind()


        oAccountsTable = DeskBack.FindMainTable(tblAccounts)



        For Each oRow In oAccountsTable.Rows
            'If oRow.AccountName = Me.cmbAccount.Text Then
            Me.cmbAccount.Items.Add(oRow.AccountName)
            oEquity.Text = Format(System.Math.Round(oRow.Equity, 2), "$#,##0.00").ToString()
            oBalance.Text = Format(System.Math.Round(oRow.Balance, 2), "$#,##0.00")
            oUsableMr.Text = Format(System.Math.Round(oRow.UsableMargin, 2), "$#,##0.00")
            Exit For
            'End If
        Next oRow



        oEquity.UpdateAfterCallBack = True
        oEquity.DataBind()


        oBalance.UpdateAfterCallBack = True
        oBalance.DataBind()


        oUsableMr.UpdateAfterCallBack = True
        oUsableMr.DataBind()

        cmbAccount.UpdateAfterCallBack = True
        cmbAccount.DataBind()

        cmdLogin.Enabled = False
        cmdLogin.UpdateAfterCallBack = True
        cmdLogin.DataBind()

        lblMess.Text = Marquee()
        lblMess.ForeColor = Color.Green
        lblMess.UpdateAfterCallBack = True
        lblMess.DataBind()


        Synchronize()

    End Sub



    Sub EURUSD()


        Dim opExec As New cs_Operation

        Dim strNow As String
        strNow = CStr(Now)
        Dim isTradeExistSell, isTradeExistBuy As Boolean


        strSignal = Text2String("C:\Program Files (x86)\MetaTrader - AAAFx\experts\files\Signals.txt")

        Dim strDirection, strSymbol, strRate, strSL As Object
        Dim strTarget As String
        Dim arr() As String

        If strSignal <> "" Then
            arr = Split(strSignal, "-")
        Else
            Exit Sub
        End If

        Dim str_Renamed As String
        str_Renamed = Text2String("C:\Program Files (x86)\MetaTrader - AAAFx\experts\files\BuySell.txt")


        If (str_Renamed.Trim = "Buy") Then
            EURImg.ImageUrl = "picture\up.gif"
            EURImg.UpdateAfterCallBack = True
            EURImg.DataBind()
        End If
        If (str_Renamed.Trim = "Sell") Then
            EURImg.ImageUrl = "picture\down.gif"
            EURImg.UpdateAfterCallBack = True
            EURImg.DataBind()
        End If
        If (str_Renamed.Trim = "") Then
            EURImg.ImageUrl = "picture\flat.gif"
            EURImg.UpdateAfterCallBack = True
            EURImg.DataBind()
        End If

        If UBound(arr) - LBound(arr) + 1 = 6 Then

            strSignal = arr(0)

            If InStr(1, strSignal, "Close Sell", CompareMethod.Text) > 0 Then

                opExec.ExecuteSql("update Signal set [Status] = 'C',dtDateClose='" & Now & "' where [Status] = 'T' and SignalType = 'BOLLDOWNBREAK' and ([Curr]='EURUSD' or [Curr]='EUR/USD')")

                Try


                    Dim oRow As Object
                    oTradesTable = DeskBack.FindMainTable("Trades")
                    For Each oRow In oTradesTable.Rows


                        If (oRow.BS = "S" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                            Exit For
                        End If

                    Next

                Catch ex As Exception
                    Response.Write("Error while Closing EURUSD Sell")
                End Try


                If InStr(1, str_Renamed, "Sell", CompareMethod.Text) > 0 Then
                    clearBuySell()
                End If

                clearFile()

            End If

            If InStr(1, strSignal, "Close Buy", CompareMethod.Text) > 0 Then


                opExec.ExecuteSql("update Signal set [Status] = 'C', dtDateClose='" & Now & "' where [Status] = 'T' and SignalType = 'BOLLUPBREAK' and ([Curr]='EURUSD' or [Curr]='EUR/USD')")

                Try


                    Dim oRow As Object
                    oTradesTable = DeskBack.FindMainTable("Trades")
                    For Each oRow In oTradesTable.Rows


                        If (oRow.BS = "B" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                            Exit For
                        End If

                    Next

                Catch ex As Exception
                    Response.Write("Error while Closing EURUSD Buy")
                End Try


                If InStr(1, str_Renamed, "Buy", CompareMethod.Text) > 0 Then
                    Call clearBuySell()
                End If
                clearFile()

            End If

        End If


        Dim signal As Object
        Dim strType As String
        If UBound(arr) - LBound(arr) + 1 = 5 Then
            strSymbol = arr(1)
            strRate = arr(2)
            strDirection = arr(0)
            strSL = arr(4)
            strTarget = arr(3)
            signal = strDirection + " " + strSymbol + " now at " + strRate + " Target = " + strTarget + " SL = " + strSL
            If strDirection = "Long" Then strType = "BOLLUPBREAK"
            If strDirection = "Short" Then strType = "BOLLDOWNBREAK"

            If (strType = "BOLLUPBREAK" And InStr(1, str_Renamed, "Buy", CompareMethod.Text) > 0 And isTradeExistBuy = False) Or (strType = "BOLLDOWNBREAK" And InStr(1, str_Renamed, "Sell", CompareMethod.Text) > 0 And isTradeExistSell = False) Then

                opExec.ExecuteSql("insert into Signal([Signal],Comments,[Status],[Pivot],dtDateSignal,dtDateClose,[Entry],SL,[Target],SignalType,[curr],StudyTime,isFreeSignal,AmountK) values ('" & signal & "','','T','','" & strNow & "','','" & strRate & "','" & strSL & "','" & strTarget & "','" & strType & "','" & strSymbol & "','',yes," & cmbAmountK.Text & ")")

                If (OpenTrade(strDirection, strSL, strTarget, "EUR/USD", min_amount, strRate, trade, di) = False) Then
                    Response.Write("Failed to create a EURUSD trade")

                Else

                    Dim oRow As Object
                    oTradesTable = DeskBack.FindRowInTable("offers", "Instrument", instrument)
                    For Each oRow In oTradesTable.Rows

                        If (strDirection = "Long" And oRow.BS = "S" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                        End If
                        If (strDirection = "Short" And oRow.BS = "B" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                        End If

                    Next


                End If

                opExec.ExecuteSql("update Signal set [Status] = 'C',dtDateClose='" & Now & "' where [Status] = 'T' and SignalType <> '" & strType & "' and [curr] = 'EURUSD' ")

            End If

            clearFile()

        Else

            If InStr(1, strSignal, "Close Sell", CompareMethod.Text) > 0 Then

                opExec.ExecuteSql("update Signal set [Status] = 'C', dtDateClose='" & Now & "' where [Status] = 'T' and SignalType = 'BOLLDOWNBREAK' and ([Curr]='EURUSD' or [Curr]='EUR/USD')")

                Try


                    Dim oRow As Object
                    oTradesTable = DeskBack.FindMainTable("Trades")
                    For Each oRow In oTradesTable.Rows


                        If (oRow.BS = "S" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                            Exit For
                        End If

                    Next

                Catch ex As Exception
                    Response.Write("Error while Closing EURUSD Sell")
                End Try

                clearFile()
                If InStr(1, str_Renamed, "Sell", CompareMethod.Text) > 0 Then
                    Call clearBuySell()
                End If

            End If

            If InStr(1, strSignal, "Close Buy", CompareMethod.Text) > 0 Then

                opExec.ExecuteSql("update Signal set [Status] = 'C', dtDateClose='" & Now & "' where [Status] = 'T' and SignalType = 'BOLLUPBREAK' and ([Curr]='EURUSD' or [Curr]='EUR/USD')")

                Try


                    Dim oRow As Object
                    oTradesTable = DeskBack.FindMainTable("Trades")
                    For Each oRow In oTradesTable.Rows


                        If (oRow.BS = "B" And oRow.Instrument = "EUR/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                            Exit For
                        End If

                    Next

                Catch ex As Exception
                    Response.Write("Error while Closing EURUSD Buy")
                End Try


                clearFile()
                If InStr(1, str_Renamed, "Buy", CompareMethod.Text) > 0 Then
                    Call clearBuySell()
                End If

            End If

        End If


    End Sub



