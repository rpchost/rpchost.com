                        If (strDirection = "Short" And oRow.BS = "B" And oRow.Instrument = "GBP/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                        End If

                    Next


                End If


                opExec.ExecuteSql("update Signal set [Status] = 'C',dtDateClose='" & Now & "' where [Status] = 'T' and SignalType <> '" & strType & "' and [curr] = 'GBPUSD' ")


            End If

            clearFile()

        Else

            If InStr(1, strSignal, "Close Sell", CompareMethod.Text) > 0 Then

                opExec.ExecuteSql("update Signal set [Status] = 'C', dtDateClose='" & Now & "' where [Status] = 'T' and SignalType = 'BOLLDOWNBREAK' and ([Curr]='GBPUSD' or [Curr]='GBP/USD')")

                Try


                    Dim oRow As Object
                    oTradesTable = DeskBack.FindMainTable("Trades")
                    For Each oRow In oTradesTable.Rows


                        If (oRow.BS = "S" And oRow.Instrument = "GBP/USD") Then
                            CloseTrade(oRow.TradeID, oRow.BS, oRow.Instrument)
                            Exit For
                        End If

