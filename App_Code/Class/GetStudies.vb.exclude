        w = New StreamReader(fs)

        strLine = Trim(w.ReadLine)

        While InStr(1, strLine, "tech-table") = 0 And w.Peek >= 0
            strLine = Trim(w.ReadLine)
        End While
        strLine = ""
        While InStr(1, strLine, "AUDUSD") = 0 And w.Peek >= 0
            strLine = Trim(w.ReadLine)
        End While

        Dim arr() As String
        Dim arrRes() As String

        Try

            arr = strLine.Split("<td>")
            strLine = arr(6)
            arr = strLine.Split(">")
            AUDUSDtTime = arr(1)

            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            strLine = arr(4)

            arrRes = strLine.Split(">") : AUDUSDEMA8 = arrRes(1)

            AUDUSDADX = arr(8) : arrRes = AUDUSDADX.Split(">") : AUDUSDADX = arrRes(1)
            AUDUSDMACDValue = arr(12) : arrRes = AUDUSDMACDValue.Split(">") : AUDUSDMACDValue = arrRes(1)

            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            AUDUSDEMA21 = arr(4) : arrRes = AUDUSDEMA21.Split(">") : AUDUSDEMA21 = arrRes(1)
            AUDUSDPosDMI = arr(8) : arrRes = AUDUSDPosDMI.Split(">") : AUDUSDPosDMI = arrRes(1)
            AUDUSDMACDSignal = arr(12) : arrRes = AUDUSDMACDSignal.Split(">") : AUDUSDMACDSignal = arrRes(1)
            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)
            arr = strLine.Split("</td><td>")
            AUDUSDEMA55 = arr(4) : arrRes = AUDUSDEMA55.Split(">") : AUDUSDEMA55 = arrRes(1)
            AUDUSDNegDMI = arr(8) : arrRes = AUDUSDNegDMI.Split(">") : AUDUSDNegDMI = arrRes(1)
            AUDUSDRSI = arr(12) : arrRes = AUDUSDRSI.Split(">") : AUDUSDRSI = arrRes(1)

            fs.Close()
            w.Close()

        Catch ex As Exception

            w = New StreamReader(fs)
            strLine = Trim(w.ReadLine)
            While InStr(1, strLine, ">Technical Studies<") = 0 And w.Peek >= 0
                strLine = Trim(w.ReadLine)
            End While
            ' strLine = ""

            'arr = strLine.Split("<td>")
            'strLine = arr(6)
            'arr = strLine.Split(">")
            AUDUSDtTime = System.String.Format("{0: hh:00:00 tt}", Convert.ToDateTime(Now))

            ' strLine = Trim(w.ReadLine)
            ' strLine = Trim(w.ReadLine)
            ' strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            strLine = arr(4)

            arrRes = strLine.Split(">") : AUDUSDEMA8 = arrRes(1)

            AUDUSDADX = arr(8) : arrRes = AUDUSDADX.Split(">") : AUDUSDADX = arrRes(1)
            AUDUSDMACDValue = arr(12) : arrRes = AUDUSDMACDValue.Split(">") : AUDUSDMACDValue = arrRes(1)

            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            AUDUSDEMA21 = arr(4) : arrRes = AUDUSDEMA21.Split(">") : AUDUSDEMA21 = arrRes(1)
            AUDUSDPosDMI = arr(8) : arrRes = AUDUSDPosDMI.Split(">") : AUDUSDPosDMI = arrRes(1)
            AUDUSDMACDSignal = arr(12) : arrRes = AUDUSDMACDSignal.Split(">") : AUDUSDMACDSignal = arrRes(1)
            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)
            arr = strLine.Split("</td><td>")
            AUDUSDEMA55 = arr(4) : arrRes = AUDUSDEMA55.Split(">") : AUDUSDEMA55 = arrRes(1)
            AUDUSDNegDMI = arr(8) : arrRes = AUDUSDNegDMI.Split(">") : AUDUSDNegDMI = arrRes(1)
            AUDUSDRSI = arr(12) : arrRes = AUDUSDRSI.Split(">") : AUDUSDRSI = arrRes(1)

            fs.Close()
            w.Close()

        End Try

        Return strLine

    End Function

End Class

