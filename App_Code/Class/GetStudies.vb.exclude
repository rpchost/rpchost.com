    Private Function getHtml(ByVal str As String) As String

        Dim objResponse As System.Net.WebResponse
        Dim objRequest As System.Net.WebRequest
        objRequest = HttpWebRequest.Create(str)
        objResponse = objRequest.GetResponse()
        Dim sr As New System.IO.StreamReader(objResponse.GetResponseStream())
        Return sr.ReadToEnd()

    End Function

    Private Sub writeToHtml(ByVal Str As String)

        Dim LogFile As New FileInfo(strFilePath)
        Dim fs1 As FileStream
        Dim w1 As StreamWriter

        If LogFile.Exists Then

            'Try
            LogFile.Delete()
            ' fs1 = New FileStream(strFilePath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None)
            ' Catch ex As Exception
            ' LogFile = New FileInfo(strFilePathBack)
            ' fs1 = New FileStream(strFilePathBack, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None)
            ' End Try

            fs1 = New FileStream(strFilePath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None)

            fs1.Lock(0, SeekOrigin.End)
            w1 = New StreamWriter(fs1)

            w1.BaseStream.Seek(0, SeekOrigin.End)

            w1.Write(getHtml(Str))

            fs1.Unlock(0, SeekOrigin.End)

            w1.Flush()

            w1.Close()
            fs1.Close()

        End If

        'Dispose()

    End Sub

    Private Function GetNumbers() As String

        Dim strEcon As String
        Dim strRes As String
        Dim strLine As String
        Dim fs As FileStream
        Dim w As StreamReader

        fs = New FileStream(strFilePath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None)

        w = New StreamReader(fs)

        strLine = Trim(w.ReadLine)

        While InStr(1, strLine, "tech-table") = 0 And w.Peek >= 0
            strLine = Trim(w.ReadLine)
        End While
        strLine = ""
        While InStr(1, strLine, "GBPUSD") = 0 And w.Peek >= 0
            strLine = Trim(w.ReadLine)
        End While

        Dim arr() As String
        Dim arrRes() As String

        Try

            arr = strLine.Split("<td>")
            strLine = arr(6)
            arr = strLine.Split(">")
            tTime = arr(1)

            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            strLine = arr(4)

            arrRes = strLine.Split(">") : EMA8 = arrRes(1)

            ADX = arr(8) : arrRes = ADX.Split(">") : ADX = arrRes(1)
            MACDValue = arr(12) : arrRes = MACDValue.Split(">") : MACDValue = arrRes(1)

            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            EMA21 = arr(4) : arrRes = EMA21.Split(">") : EMA21 = arrRes(1)

            PosDMI = arr(8) : arrRes = PosDMI.Split(">") : PosDMI = arrRes(1)

            MACDSignal = arr(12) : arrRes = MACDSignal.Split(">") : MACDSignal = arrRes(1)
            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)
            arr = strLine.Split("</td><td>")
            EMA55 = arr(4) : arrRes = EMA55.Split(">") : EMA55 = arrRes(1)
            NegDMI = arr(8) : arrRes = NegDMI.Split(">") : NegDMI = arrRes(1)
            RSI = arr(12) : arrRes = RSI.Split(">") : RSI = arrRes(1)

            fs.Close()
            w.Close()

        Catch ex As Exception

            w = New StreamReader(fs)
            strLine = Trim(w.ReadLine)
            While InStr(1, strLine, ">Technical Studies<") = 0 And w.Peek >= 0
                strLine = Trim(w.ReadLine)
            End While
            ' strLine = ""

            'arr = strLine.Split("<td>")
            'strLine = arr(6)
            'arr = strLine.Split(">")
            tTime = System.String.Format("{0: hh:00:00 tt}", Convert.ToDateTime(Now))

            ' strLine = Trim(w.ReadLine)
            ' strLine = Trim(w.ReadLine)
            ' strLine = Trim(w.ReadLine)
            strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            strLine = arr(4)

            arrRes = strLine.Split(">") : EMA8 = arrRes(1)

            ADX = arr(8) : arrRes = ADX.Split(">") : ADX = arrRes(1)
            MACDValue = arr(12) : arrRes = MACDValue.Split(">") : MACDValue = arrRes(1)

            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)

            arr = strLine.Split("</td><td>")
            EMA21 = arr(4) : arrRes = EMA21.Split(">") : EMA21 = arrRes(1)
            PosDMI = arr(8) : arrRes = PosDMI.Split(">") : PosDMI = arrRes(1)
            MACDSignal = arr(12) : arrRes = MACDSignal.Split(">") : MACDSignal = arrRes(1)
            strLine = Trim(w.ReadLine)
            'strLine = Trim(w.ReadLine)
            arr = strLine.Split("</td><td>")
            EMA55 = arr(4) : arrRes = EMA55.Split(">") : EMA55 = arrRes(1)
            NegDMI = arr(8) : arrRes = NegDMI.Split(">") : NegDMI = arrRes(1)
            RSI = arr(12) : arrRes = RSI.Split(">") : RSI = arrRes(1)

            fs.Close()
            w.Close()

        End Try

        Return strLine

    End Function


