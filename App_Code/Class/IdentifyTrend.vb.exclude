    Public Function Signal() As String

        'If TrendEMA = "UP" And ADXTrend = "STRONG" And RSITrend = "UP" And MACDTrend = "UP" Then
        If (TrendEMA = "UP" Or TrendEMA = "UPEMA") And MACDTrend = "UP" And RSITrend = "UP" Then
            Target = 15
            Return "BUY"
            'ElseIf TrendEMA = "GOUP" And ADXTrend = "STRONG" And RSITrend = "UP" And MACDTrend = "UP" Then
        ElseIf TrendEMA = "GOUP" And MACDTrend = "UP" And RSITrend = "UP" Then
            Target = 20
            Return "BUY"
            'ElseIf TrendEMA = "DOWN" And ADXTrend = "STRONG" And RSITrend = "DOWN" And MACDTrend = "DOWN" Then
        ElseIf (TrendEMA = "DOWN" Or TrendEMA = "DOWNEMA") And MACDTrend = "DOWN" And RSITrend = "DOWN" Then
            Target = 15
            Return "SELL"
            'ElseIf TrendEMA = "GODOWN" And ADXTrend = "STRONG" And RSITrend = "DOWN" And MACDTrend = "DOWN" Then
        ElseIf TrendEMA = "GODOWN" And MACDTrend = "DOWN" And RSITrend = "DOWN" Then
            Target = 20
            Return "SELL"
        Else
            If TrendEMA = "" Then Return "NEUTRAL"
            If TrendEMA <> "" Then Return TrendEMA
        End If

    End Function

