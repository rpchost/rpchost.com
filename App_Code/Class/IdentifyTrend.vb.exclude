            End If

            'Identyfying variables

            If GBPJPYEMA8_1 = "" Or IsNothing(GBPJPYEMA8_1) Or GBPJPYEMA8_2 = "" Or IsNothing(GBPJPYEMA8_2) Or GBPJPYEMA8_3 = "" Or IsNothing(GBPJPYEMA8_3) Then
                GBPJPYTrendEMA = ""
                Exit Sub
            End If

            If CDbl(GBPJPYEMA8_1) > CDbl(GBPJPYEMA8_2) And Math.Abs(CDbl(Replace(GBPJPYEMA8_1, ".", "")) - CDbl(Replace(GBPJPYEMA8_2, ".", ""))) >= 3 Then
                GbpJpyEMA8 = "UP"
            ElseIf CDbl(GBPJPYEMA8_1) < CDbl(GBPJPYEMA8_2) And Math.Abs(CDbl(Replace(GBPJPYEMA8_2, ".", "")) - CDbl(Replace(GBPJPYEMA8_1, ".", ""))) >= 3 Then
                GbpJpyEMA8 = "DOWN"
            End If

            If CDbl(GbpJpyPosDMI_1) > CDbl(GbpJpyPosDMI_2) Then
                posGbpJpyDMI = "UP"
            Else
                posGbpJpyDMI = "DOWN"
            End If
            If CDbl(GbpJpyNegDMI_1) > CDbl(GbpJpyNegDMI_2) Then
                NegGbpJpyDMI = "UP"
            Else
                NegGbpJpyDMI = "DOWN"
            End If


            If CDbl(GBPJPYEMA8_1) > CDbl(GBPJPYEMA8_2) And CDbl(GBPJPYEMA8_2) > CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_1) > CDbl(GbpJpyEMA21_1) Then
                GBPJPYTrendEMA = "UP"
            End If
            If CDbl(GBPJPYEMA8_1) > CDbl(GBPJPYEMA8_2) And CDbl(GBPJPYEMA8_2) > CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_1) > CDbl(GbpJpyEMA21_1) And CDbl(GbpJpyEMA21_1) > CDbl(GbpJpyEMA55_1) Then
                GBPJPYTrendEMA = "GOUP"
            End If
            If CDbl(GBPJPYEMA8_1) < CDbl(GBPJPYEMA8_2) And CDbl(GBPJPYEMA8_2) < CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_1) < CDbl(GbpJpyEMA21_1) Then
                GBPJPYTrendEMA = "DOWN"
            End If
            If CDbl(GBPJPYEMA8_1) < CDbl(GBPJPYEMA8_2) And CDbl(GBPJPYEMA8_2) < CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_1) < CDbl(GbpJpyEMA21_1) And CDbl(GbpJpyEMA21_1) < CDbl(GbpJpyEMA55_1) Then
                GBPJPYTrendEMA = "GODOWN"
            End If

            If (CDbl(GbpJpyADX_1) > CDbl(GbpJpyADX_2) And CDbl(GbpJpyADX_2) > CDbl(GbpJpyADX_3)) Then 'And CDbl(GbpJpyADX_1) >= 15) Then  'And ADX_2 > ADX_3 And ADX_1 >= 20 Then
                GbpJpyADXTrend = "STRONG"
            Else
                GbpJpyADXTrend = "NEUTRAL"
            End If

            NegGbpJpyCrossDMI = ""
            PosGbpJpyCrossDMI = ""

            'If CDbl(GBPJPYPosDMI_1) > CDbl(GBPJPYPosDMI_2) And CDbl(GBPJPYNegDMI_1) < CDbl(GBPJPYNegDMI_2) And CDbl(GBPJPYPosDMI_2) < CDbl(GBPJPYNegDMI_2) And CDbl(GBPJPYPosDMI_1) > CDbl(GBPJPYNegDMI_1) Then
            If posGbpJpyDMI = "UP" And NegGbpJpyDMI = "DOWN" And CDbl(GbpJpyPosDMI_1) > CDbl(GbpJpyNegDMI_1) Then
                PosGbpJpyCrossDMI = "PosDMICROSSUP"
                NegGbpJpyCrossDMI = ""
            End If
            'If CDbl(GBPJPYNegDMI_1) > CDbl(GBPJPYNegDMI_2) And CDbl(GBPJPYPosDMI_1) < CDbl(GBPJPYPosDMI_2) And CDbl(GBPJPYNegDMI_2) < CDbl(GBPJPYPosDMI_2) And CDbl(GBPJPYNegDMI_1) > CDbl(GBPJPYPosDMI_1) Then
            If posGbpJpyDMI = "DOWN" And NegGbpJpyDMI = "UP" And CDbl(GbpJpyNegDMI_1) > CDbl(GbpJpyPosDMI_1) Then
                NegGbpJpyCrossDMI = "NegDMICROSSUP"
                PosGbpJpyCrossDMI = ""
            End If


            If GbpJpyRSI_1 > GbpJpyRSI_2 And GbpJpyRSI_1 <= 72 Then
                GbpJpyRSITrend = "UP"
            ElseIf GbpJpyRSI_1 > 72 Then
                GbpJpyRSITrend = "OB"
            ElseIf GbpJpyRSI_1 < GbpJpyRSI_2 And GbpJpyRSI_1 >= 30 Then
                GbpJpyRSITrend = "DOWN"
            ElseIf GbpJpyRSI_1 < 28 Then
                GbpJpyRSITrend = "OS"
            Else
                GbpJpyRSITrend = "NEUTRAL"
            End If

            If CDbl(GbpJpyMacdVal_1) > CDbl(GbpJpyMacdSignal_1) And CDbl(GbpJpyMacdVal_2) > CDbl(GbpJpyMacdSignal_2) And (CDbl(GbpJpyMacdVal_1) > CDbl(GbpJpyMacdVal_2) And CDbl(GbpJpyMacdSignal_1) > CDbl(GbpJpyMacdSignal_2)) And Math.Abs(CDbl(GbpJpyMacdVal_1) - CDbl(GbpJpyMacdVal_2)) > 1 Then 'And macdVal_3 > macdSignal_3 Then
                GbpJpyMACDTrend = "UP"
            ElseIf CDbl(GbpJpyMacdVal_1) < CDbl(GbpJpyMacdSignal_1) And CDbl(GbpJpyMacdVal_2) < CDbl(GbpJpyMacdSignal_2) And (CDbl(GbpJpyMacdVal_1) < CDbl(GbpJpyMacdVal_2) And CDbl(GbpJpyMacdSignal_1) < CDbl(GbpJpyMacdSignal_2)) And Math.Abs(CDbl(GbpJpyMacdVal_1) - CDbl(GbpJpyMacdVal_2)) > 1 Then 'And macdVal_3 < macdSignal_3 Then
                GbpJpyMACDTrend = "DOWN"
            ElseIf CDbl(GbpJpyMacdVal_1) > CDbl(GbpJpyMacdSignal_1) And CDbl(GbpJpyMacdVal_2) > CDbl(GbpJpyMacdSignal_2) And (CDbl(GbpJpyMacdVal_1) > CDbl(GbpJpyMacdVal_2) And CDbl(GbpJpyMacdSignal_1) > CDbl(GbpJpyMacdSignal_2)) And Math.Abs(CDbl(GbpJpyMacdVal_1) - CDbl(GbpJpyMacdVal_2)) = 1 Then
                GbpJpyMACDTrend = "SOFTNEUTRAL"
            ElseIf CDbl(GbpJpyMacdVal_1) < CDbl(GbpJpyMacdSignal_1) And CDbl(GbpJpyMacdVal_2) < CDbl(GbpJpyMacdSignal_2) And (CDbl(GbpJpyMacdVal_1) < CDbl(GbpJpyMacdVal_2) And CDbl(GbpJpyMacdSignal_1) < CDbl(GbpJpyMacdSignal_2)) And Math.Abs(CDbl(GbpJpyMacdVal_1) - CDbl(GbpJpyMacdVal_2)) = 1 Then 'And macdVal_3 < macdSignal_3 Then
                GbpJpyMACDTrend = "SOFTNEUTRAL"
            Else
                GbpJpyMACDTrend = "NEUTRAL"
            End If

            'If CDbl(GBPJPYEMA8_1) > CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_3) < CDbl(reader("EMA21")) And CDbl(GBPJPYEMA8_1) > CDbl(reader("EMA21")) Then 'And MACDTrend = "UP" Then
            '    GBPJPYTrendEMA = "UPEMA"
            'End If
            'If CDbl(GBPJPYEMA8_1) < CDbl(GBPJPYEMA8_3) And CDbl(GBPJPYEMA8_1) < CDbl(reader("EMA21")) And CDbl(GBPJPYEMA8_3) > CDbl(reader("EMA21")) Then 'And MACDTrend = "DOWN" Then
            '    GBPJPYTrendEMA = "DOWNEMA"
            'End If
            'If CDbl(GbpJpyEMA21_1) > CDbl(GbpJpyEMA21_3) And CDbl(GbpJpyEMA21_1) > CDbl(reader("EMA55")) And CDbl(GbpJpyEMA21_3) < CDbl(reader("EMA55")) Then
            '    GBPJPYTrendEMA = "LONGUPEMA"
            'End If
            'If CDbl(GbpJpyEMA21_1) < CDbl(GbpJpyEMA21_3) And CDbl(GbpJpyEMA21_1) < CDbl(reader("EMA55")) And CDbl(GbpJpyEMA21_3) > CDbl(reader("EMA55")) Then
            '    GBPJPYTrendEMA = "LONGDOWNEMA"
            'End If

        Catch ex As Exception
            HttpContext.Current.Response.Write(ex.Message)
        Finally
            reader.Close()
            opExec.closeConnection()
        End Try

    End Sub

    Public Sub SetCandle()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from rates1 order by dtDate DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                reader.Read()
                CloseEurJpy = reader("ClosedEurJpy")
                CloseEurChf = reader("ClosedEurChf")
                CloseGbpJpy = reader("ClosedGbpJpy")
                CloseGbpUsd = reader("ClosedGbpUsd")
                CloseAudUSd = reader("ClosedAudUsd")

                reader.Read()
                OpenEurJpy = reader("PriceEurJpy")
                OpenEurChf = reader("PriceEurChf")
                OpenGbpJpy = reader("PriceGbpJpy")
                OpenGbpUsd = reader("PriceGbpUsd")
                OpenAudUSd = reader("PriceAudUsd")


                If (CDbl(CloseEurJpy) < CDbl(OpenEurJpy)) Then
                    CandleEurJpy = "DOWN"
                ElseIf (CDbl(CloseEurJpy) > CDbl(OpenEurJpy)) Then
                    CandleEurJpy = "UP"
                Else
                    CandleEurJpy = "NEUTRAL"
                End If

                If (CDbl(CloseEurChf) < CDbl(OpenEurChf)) Then
                    CandleEurChf = "DOWN"
                ElseIf (CDbl(CloseEurChf) > CDbl(OpenEurChf)) Then
                    CandleEurChf = "UP"
                Else
                    CandleEurChf = "NEUTRAL"
                End If

                If (CDbl(CloseGbpJpy) < CDbl(OpenGbpJpy)) Then
                    CandleGbpJpy = "DOWN"
                ElseIf (CDbl(CloseGbpJpy) > CDbl(OpenGbpJpy)) Then
                    CandleGbpJpy = "UP"
                Else
                    CandleGbpJpy = "NEUTRAL"
                End If

                If (CDbl(CloseGbpUsd) < CDbl(OpenGbpUsd)) Then
                    CandleGbpUsd = "DOWN"
                ElseIf (CDbl(CloseGbpUsd) > CDbl(OpenGbpUsd)) Then
                    CandleGbpUsd = "UP"
                Else
                    CandleGbpUsd = "NEUTRAL"
                End If

                If (CDbl(CloseAudUSd) < CDbl(OpenAudUSd)) Then
                    CandleAudUSd = "DOWN"
                ElseIf (CDbl(CloseAudUSd) > CDbl(OpenAudUSd)) Then
                    CandleAudUsd = "UP"
                Else
                    CandleAudUsd = "NEUTRAL"
                End If

            End If

        Catch ex As Exception


        End Try

    End Sub


    Public Sub TrendAUDUSD()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        NegAudUsdDMI = ""
        posAudUsdDMI = ""

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from study where curr = 'AUDUSD' order by TimeNow DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                'IDENTIFICATION EMA8_1
                AUDUSDEMA8_1 = reader("EMA8")
                AudUsdEMA21_1 = reader("EMA21")
                AudUsdEMA55_1 = reader("EMA55")
                AudUsdPosDMI_1 = reader("PosDMI")
                AudUsdNegDMI_1 = reader("NegDMI")

                'IDENTIFICATION ADX_1
                AudUsdADX_1 = reader("ADX")

                'IDENTIFICATION RSI_1
                AudUsdRSI_1 = reader("RSI")

                'IDENTIFICATION macd_1
                AudUsdMacdVal_1 = reader("MACDValue")
                AudUsdMacdSignal_1 = reader("MACDSignal")

                reader.Read()

                AUDUSDEMA8_2 = reader("EMA8")
                AudUsdEMA21_2 = reader("EMA21")
                AudUsdPosDMI_2 = reader("PosDMI")
                AudUsdNegDMI_2 = reader("NegDMI")

                'IDENTIFICATION ADX_2
                AudUsdADX_2 = reader("ADX")
                'IDENTIFICATION RSI_2
                AudUsdRSI_2 = reader("RSI")

                'IDENTIFICATION macd_2
                AudUsdMacdVal_2 = reader("MACDValue")
                AudUsdMacdSignal_2 = reader("MACDSignal")

                reader.Read()

                AUDUSDEMA8_3 = reader("EMA8")
                AudUsdEMA21_3 = reader("EMA21")

                'IDENTIFICATION ADX_3
                AudUsdADX_3 = reader("ADX")

                'IDENTIFICATION RSI_3
                AudUsdRSI_3 = reader("RSI")

                'IDENTIFICATION macd_3
                'macdVal_3 = reader("MACDValue")
                'macdSignal_3 = reader("MACDSignal")

            End If

            'Identyfying variables

            If AUDUSDEMA8_1 = "" Or IsNothing(AUDUSDEMA8_1) Or AUDUSDEMA8_2 = "" Or IsNothing(AUDUSDEMA8_2) Or AUDUSDEMA8_3 = "" Or IsNothing(AUDUSDEMA8_3) Then
                AUDUSDTrendEMA = ""
                Exit Sub
            End If

            If CDbl(AUDUSDEMA8_1) > CDbl(AUDUSDEMA8_2) And Math.Abs(CDbl(Replace(AUDUSDEMA8_1, ".", "")) - CDbl(Replace(AUDUSDEMA8_2, ".", ""))) >= 3 Then
                AudUsdEMA8 = "UP"
            ElseIf CDbl(AUDUSDEMA8_1) < CDbl(AUDUSDEMA8_2) And Math.Abs(CDbl(Replace(AUDUSDEMA8_2, ".", "")) - CDbl(Replace(AUDUSDEMA8_1, ".", ""))) >= 3 Then
                AudUsdEMA8 = "DOWN"
            End If

            If CDbl(AudUsdPosDMI_1) > CDbl(AudUsdPosDMI_2) Then
                posAudUsdDMI = "UP"
            Else
                posAudUsdDMI = "DOWN"
            End If
            If CDbl(AudUsdNegDMI_1) > CDbl(AudUsdNegDMI_2) Then
                NegAudUsdDMI = "UP"
            Else
                NegAudUsdDMI = "DOWN"
            End If


            If CDbl(AUDUSDEMA8_1) > CDbl(AUDUSDEMA8_2) And CDbl(AUDUSDEMA8_2) > CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_1) > CDbl(AudUsdEMA21_1) Then
                AUDUSDTrendEMA = "UP"
            End If
            If CDbl(AUDUSDEMA8_1) > CDbl(AUDUSDEMA8_2) And CDbl(AUDUSDEMA8_2) > CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_1) > CDbl(AudUsdEMA21_1) And CDbl(AudUsdEMA21_1) > CDbl(AudUsdEMA55_1) Then
                AUDUSDTrendEMA = "GOUP"
            End If
            If CDbl(AUDUSDEMA8_1) < CDbl(AUDUSDEMA8_2) And CDbl(AUDUSDEMA8_2) < CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_1) < CDbl(AudUsdEMA21_1) Then
                AUDUSDTrendEMA = "DOWN"
            End If
            If CDbl(AUDUSDEMA8_1) < CDbl(AUDUSDEMA8_2) And CDbl(AUDUSDEMA8_2) < CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_1) < CDbl(AudUsdEMA21_1) And CDbl(AudUsdEMA21_1) < CDbl(AudUsdEMA55_1) Then
                AUDUSDTrendEMA = "GODOWN"
            End If

            If (CDbl(AudUsdADX_1) > CDbl(AudUsdADX_2) And CDbl(AudUsdADX_2) >= CDbl(AudUsdADX_3)) Then 'And CDbl(AudUsdADX_1) >= 15) Then 'And ADX_2 > ADX_3 And ADX_1 >= 20 Then
                AudUsdADXTrend = "STRONG"
            Else
                AudUsdADXTrend = "NEUTRAL"
            End If

            NegAudUsdCrossDMI = ""
            PosAudUsdCrossDMI = ""

            'If CDbl(AUDUSDPosDMI_1) > CDbl(AUDUSDPosDMI_2) And CDbl(AUDUSDNegDMI_1) < CDbl(AUDUSDNegDMI_2) And CDbl(AUDUSDPosDMI_2) < CDbl(AUDUSDNegDMI_2) And CDbl(AUDUSDPosDMI_1) > CDbl(AUDUSDNegDMI_1) Then
            If posAudUsdDMI = "UP" And NegAudUsdDMI = "DOWN" And CDbl(AudUsdPosDMI_1) > CDbl(AudUsdNegDMI_1) Then
                PosAudUsdCrossDMI = "PosDMICROSSUP"
                NegAudUsdCrossDMI = ""
            End If
            'If CDbl(AUDUSDNegDMI_1) > CDbl(AUDUSDNegDMI_2) And CDbl(AUDUSDPosDMI_1) < CDbl(AUDUSDPosDMI_2) And CDbl(AUDUSDNegDMI_2) < CDbl(AUDUSDPosDMI_2) And CDbl(AUDUSDNegDMI_1) > CDbl(AUDUSDPosDMI_1) Then
            If posAudUsdDMI = "DOWN" And NegAudUsdDMI = "UP" And CDbl(AudUsdNegDMI_1) > CDbl(AudUsdPosDMI_1) Then
                NegAudUsdCrossDMI = "NegDMICROSSUP"
                PosAudUsdCrossDMI = ""
            End If


            If AudUsdRSI_1 > AudUsdRSI_2 And AudUsdRSI_1 <= 72 Then
                AudUsdRSITrend = "UP"
            ElseIf AudUsdRSI_1 > 72 Then
                AudUsdRSITrend = "OB"
            ElseIf AudUsdRSI_1 < AudUsdRSI_2 And AudUsdRSI_1 >= 30 Then
                AudUsdRSITrend = "DOWN"
            ElseIf AudUsdRSI_1 < 28 Then
                AudUsdRSITrend = "OS"
            Else
                AudUsdRSITrend = "NEUTRAL"
            End If

            If CDbl(AudUsdMacdVal_1) > CDbl(AudUsdMacdSignal_1) And CDbl(AudUsdMacdVal_2) > CDbl(AudUsdMacdSignal_2) And (CDbl(AudUsdMacdVal_1) > CDbl(AudUsdMacdVal_2) And CDbl(AudUsdMacdSignal_1) > CDbl(AudUsdMacdSignal_2)) And Math.Abs(CDbl(AudUsdMacdVal_1) - CDbl(AudUsdMacdVal_2)) > 1 Then 'And macdVal_3 > macdSignal_3 Then
                AudUsdMACDTrend = "UP"
            ElseIf CDbl(AudUsdMacdVal_1) < CDbl(AudUsdMacdSignal_1) And CDbl(AudUsdMacdVal_2) < CDbl(AudUsdMacdSignal_2) And (CDbl(AudUsdMacdVal_1) < CDbl(AudUsdMacdVal_2) And CDbl(AudUsdMacdSignal_1) < CDbl(AudUsdMacdSignal_2)) And Math.Abs(CDbl(AudUsdMacdVal_1) - CDbl(AudUsdMacdVal_2)) > 1 Then 'And macdVal_3 < macdSignal_3 Then
                AudUsdMACDTrend = "DOWN"
            ElseIf CDbl(AudUsdMacdVal_1) > CDbl(AudUsdMacdSignal_1) And CDbl(AudUsdMacdVal_2) > CDbl(AudUsdMacdSignal_2) And (CDbl(AudUsdMacdVal_1) > CDbl(AudUsdMacdVal_2) And CDbl(AudUsdMacdSignal_1) > CDbl(AudUsdMacdSignal_2)) And Math.Abs(CDbl(AudUsdMacdVal_1) - CDbl(AudUsdMacdVal_2)) = 1 Then
                AudUsdMACDTrend = "SOFTNEUTRAL"
            ElseIf CDbl(AudUsdMacdVal_1) < CDbl(AudUsdMacdSignal_1) And CDbl(AudUsdMacdVal_2) < CDbl(AudUsdMacdSignal_2) And (CDbl(AudUsdMacdVal_1) < CDbl(AudUsdMacdVal_2) And CDbl(AudUsdMacdSignal_1) < CDbl(AudUsdMacdSignal_2)) And Math.Abs(CDbl(AudUsdMacdVal_1) - CDbl(AudUsdMacdVal_2)) = 1 Then 'And macdVal_3 < macdSignal_3 Then
                AudUsdMACDTrend = "SOFTNEUTRAL"
            Else
                AudUsdMACDTrend = "NEUTRAL"
            End If

            'If CDbl(AUDUSDEMA8_1) > CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_3) < CDbl(reader("EMA21")) And CDbl(AUDUSDEMA8_1) > CDbl(reader("EMA21")) Then 'And MACDTrend = "UP" Then
            '    AUDUSDTrendEMA = "UPEMA"
            'End If
            'If CDbl(AUDUSDEMA8_1) < CDbl(AUDUSDEMA8_3) And CDbl(AUDUSDEMA8_1) < CDbl(reader("EMA21")) And CDbl(AUDUSDEMA8_3) > CDbl(reader("EMA21")) Then 'And MACDTrend = "DOWN" Then
            '    AUDUSDTrendEMA = "DOWNEMA"
            'End If
            'If CDbl(AudUsdEMA21_1) > CDbl(AudUsdEMA21_3) And CDbl(AudUsdEMA21_1) > CDbl(reader("EMA55")) And CDbl(AudUsdEMA21_3) < CDbl(reader("EMA55")) Then
            '    AUDUSDTrendEMA = "LONGUPEMA"
            'End If
            'If CDbl(AudUsdEMA21_1) < CDbl(AudUsdEMA21_3) And CDbl(AudUsdEMA21_1) < CDbl(reader("EMA55")) And CDbl(AudUsdEMA21_3) > CDbl(reader("EMA55")) Then
            '    AUDUSDTrendEMA = "LONGDOWNEMA"
            'End If

        Catch ex As Exception
            HttpContext.Current.Response.Write(ex.Message)
        Finally
            reader.Close()
            opExec.closeConnection()
        End Try

    End Sub

End Class

End Namespace
