    Public Sub Trend()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        posDMI = ""
        NegDMI = ""

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from study where curr = 'GBPUSD' order by TimeNow DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                'IDENTIFICATION EMA8_1
                EMA8_1 = reader("EMA8")
                EMA21_1 = reader("EMA21")
                EMA55_1 = reader("EMA55")
                PosDMI_1 = reader("PosDMI")
                NegDMI_1 = reader("NegDMI")

                'IDENTIFICATION ADX_1
                ADX_1 = reader("ADX")

                'IDENTIFICATION RSI_1
                RSI_1 = reader("RSI")

                'IDENTIFICATION macd_1
                macdVal_1 = reader("MACDValue")
                macdSignal_1 = reader("MACDSignal")

                reader.Read()

                EMA8_2 = reader("EMA8")
                EMA21_2 = reader("EMA21")
                PosDMI_2 = reader("PosDMI")
                NegDMI_2 = reader("NegDMI")

                'IDENTIFICATION ADX_2
                ADX_2 = reader("ADX")
                'IDENTIFICATION RSI_2
                RSI_2 = reader("RSI")

                'IDENTIFICATION macd_2
                macdVal_2 = reader("MACDValue")
                macdSignal_2 = reader("MACDSignal")

                reader.Read()

                EMA8_3 = reader("EMA8")
                EMA21_3 = reader("EMA21")

                'IDENTIFICATION ADX_3
                ADX_3 = reader("ADX")

                'IDENTIFICATION RSI_3
                RSI_3 = reader("RSI")

                'IDENTIFICATION macd_3
                'macdVal_3 = reader("MACDValue")
                'macdSignal_3 = reader("MACDSignal")

            End If

            'Identyfying variables

            If EMA8_1 = "" Or IsNothing(EMA8_1) Or EMA8_2 = "" Or IsNothing(EMA8_2) Or EMA8_3 = "" Or IsNothing(EMA8_3) Then
                TrendEMA = ""
                Exit Sub
            End If

            If CDbl(EMA8_1) > CDbl(EMA8_2) Then
                EMA8 = "UP"
            Else
                EMA8 = "DOWN"
            End If

            If CDbl(PosDMI_1) > CDbl(PosDMI_2) Then
                posDMI = "UP"
            Else
                posDMI = "DOWN"
            End If
            If CDbl(NegDMI_1) > CDbl(NegDMI_2) Then
                NegDMI = "UP"
            Else
                NegDMI = "DOWN"
            End If


            PosCrossDMI = ""
            NegCrossDMI = ""

            'If CDbl(PosDMI_1) > CDbl(PosDMI_2) And CDbl(NegDMI_1) < CDbl(NegDMI_2) And CDbl(PosDMI_2) < CDbl(NegDMI_2) And CDbl(PosDMI_1) > CDbl(NegDMI_1) Then
            If posDMI = "UP" And NegDMI = "DOWN" And CDbl(PosDMI_1) > CDbl(NegDMI_1) Then
                PosCrossDMI = "PosDMICROSSUP"
                NegCrossDMI = ""
            End If
            'If CDbl(NegDMI_1) > CDbl(NegDMI_2) And CDbl(PosDMI_1) < CDbl(PosDMI_2) And CDbl(NegDMI_2) < CDbl(PosDMI_2) And CDbl(NegDMI_1) > CDbl(PosDMI_1) Then
            If posDMI = "DOWN" And NegDMI = "UP" And CDbl(NegDMI_1) > CDbl(PosDMI_1) Then
                NegCrossDMI = "NegDMICROSSUP"
                PosCrossDMI = ""
            End If

            If CDbl(EMA8_1) > CDbl(EMA8_2) And CDbl(EMA8_2) > CDbl(EMA8_3) And CDbl(EMA8_1) > CDbl(EMA21_1) Then
                TrendEMA = "UP"
            End If
            If CDbl(EMA8_1) > CDbl(EMA8_2) And CDbl(EMA8_2) > CDbl(EMA8_3) And CDbl(EMA8_1) > CDbl(EMA21_1) And CDbl(EMA21_1) > CDbl(EMA55_1) Then
                TrendEMA = "GOUP"
            End If
            If CDbl(EMA8_1) < CDbl(EMA8_2) And CDbl(EMA8_2) < CDbl(EMA8_3) And CDbl(EMA8_1) < CDbl(EMA21_1) Then
                TrendEMA = "DOWN"
            End If
            If CDbl(EMA8_1) < CDbl(EMA8_2) And CDbl(EMA8_2) < CDbl(EMA8_3) And CDbl(EMA8_1) < CDbl(EMA21_1) And CDbl(EMA21_1) < CDbl(EMA55_1) Then
                TrendEMA = "GODOWN"
            End If

            If (CDbl(ADX_1) > CDbl(ADX_2) And CDbl(ADX_2) > CDbl(ADX_3)) Then 'And ADX_2 > ADX_3 And ADX_1 >= 20 Then
                ADXTrend = "STRONG"
            Else
                ADXTrend = "NEUTRAL"
            End If

            If RSI_1 > RSI_2 And RSI_1 <= 72 Then
                RSITrend = "UP"
            ElseIf RSI_1 > 72 Then
                RSITrend = "OB"
            ElseIf RSI_1 < 28 Then
                RSITrend = "OS"
            ElseIf RSI_1 < RSI_2 And RSI_1 >= 30 Then
                RSITrend = "DOWN"
            Else
                RSITrend = "NEUTRAL"
            End If

            If CDbl(macdVal_1) > CDbl(macdSignal_1) And CDbl(macdVal_2) > CDbl(macdSignal_2) And (CDbl(macdVal_1) > CDbl(macdVal_2) And CDbl(macdSignal_1) > CDbl(macdSignal_2)) And Math.Abs(CDbl(macdVal_1) - CDbl(macdVal_2)) > 1 Then
                MACDTrend = "UP"
            ElseIf CDbl(macdVal_1) < CDbl(macdSignal_1) And CDbl(macdVal_2) < CDbl(macdSignal_2) And (CDbl(macdVal_1) < CDbl(macdVal_2) And CDbl(macdSignal_1) < CDbl(macdSignal_2)) And Math.Abs(CDbl(macdVal_1) - CDbl(macdVal_2)) > 1 Then
                MACDTrend = "DOWN"
            ElseIf CDbl(macdVal_1) > CDbl(macdSignal_1) And CDbl(macdVal_2) > CDbl(macdSignal_2) And (CDbl(macdVal_1) > CDbl(macdVal_2) And CDbl(macdSignal_1) > CDbl(macdSignal_2)) And Math.Abs(CDbl(macdVal_1) - CDbl(macdVal_2)) = 1 Then
                MACDTrend = "SOFTNEUTRAL"
            ElseIf CDbl(macdVal_1) < CDbl(macdSignal_1) And CDbl(macdVal_2) < CDbl(macdSignal_2) And (CDbl(macdVal_1) < CDbl(macdVal_2) And CDbl(macdSignal_1) < CDbl(macdSignal_2)) And Math.Abs(CDbl(macdVal_1) - CDbl(macdVal_2)) = 1 Then
                MACDTrend = "SOFTNEUTRAL"
            Else
                MACDTrend = "NEUTRAL"
            End If

            'If CDbl(EMA8_1) > CDbl(EMA8_3) And CDbl(EMA8_3) < CDbl(reader("EMA21")) And CDbl(EMA8_1) > CDbl(reader("EMA21")) Then 'And MACDTrend = "UP" Then
            '    TrendEMA = "UPEMA"
            'End If
            'If CDbl(EMA8_1) < CDbl(EMA8_3) And CDbl(EMA8_1) < CDbl(reader("EMA21")) And CDbl(EMA8_3) > CDbl(reader("EMA21")) Then 'And MACDTrend = "DOWN" Then
            '    TrendEMA = "DOWNEMA"
            'End If
            'If CDbl(EMA21_1) > CDbl(EMA21_3) And CDbl(EMA21_1) > CDbl(reader("EMA55")) And CDbl(EMA21_3) < CDbl(reader("EMA55")) Then
            '    TrendEMA = "LONGUPEMA"
            'End If
            'If CDbl(EMA21_1) < CDbl(EMA21_3) And CDbl(EMA21_1) < CDbl(reader("EMA55")) And CDbl(EMA21_3) > CDbl(reader("EMA55")) Then
            '    TrendEMA = "LONGDOWNEMA"
            'End If

        Catch ex As Exception
            HttpContext.Current.Response.Write(ex.Message)
        Finally
            reader.Close()
            opExec.closeConnection()
        End Try

    End Sub


    Public Sub TrendEurJpy()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        NegEurJpyDMI = ""
        posEurJpyDMI = ""

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from study where curr = 'EURJPY' order by TimeNow DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                'IDENTIFICATION EMA8_1
                EurJpyEMA8_1 = reader("EMA8")
                EurJpyEMA21_1 = reader("EMA21")
                EurJpyEMA55_1 = reader("EMA55")
                EurJpyPosDMI_1 = reader("PosDMI")
                EurJpyNegDMI_1 = reader("NegDMI")

                'IDENTIFICATION ADX_1
                EurJpyADX_1 = reader("ADX")

                'IDENTIFICATION RSI_1
                EurJpyRSI_1 = reader("RSI")

                'IDENTIFICATION macd_1
                EurJpyMacdVal_1 = reader("MACDValue")
                EurJpyMacdSignal_1 = reader("MACDSignal")

                reader.Read()

                EurJpyEMA8_2 = reader("EMA8")
                EurJpyEMA21_2 = reader("EMA21")
                EurJpyPosDMI_2 = reader("PosDMI")
                EurJpyNegDMI_2 = reader("NegDMI")

                'IDENTIFICATION ADX_2
                EurJpyADX_2 = reader("ADX")
                'IDENTIFICATION RSI_2
                EurJpyRSI_2 = reader("RSI")

                'IDENTIFICATION macd_2
                EurJpyMacdVal_2 = reader("MACDValue")
                EurJpyMacdSignal_2 = reader("MACDSignal")

                reader.Read()

                EurJpyEMA8_3 = reader("EMA8")
                EurJpyEMA21_3 = reader("EMA21")

                'IDENTIFICATION ADX_3
                EurJpyADX_3 = reader("ADX")

                'IDENTIFICATION RSI_3
                EurJpyRSI_3 = reader("RSI")

                'IDENTIFICATION macd_3
                'macdVal_3 = reader("MACDValue")
                'macdSignal_3 = reader("MACDSignal")

            End If

            'Identyfying variables

            If EurJpyEMA8_1 = "" Or IsNothing(EurJpyEMA8_1) Or EurJpyEMA8_2 = "" Or IsNothing(EurJpyEMA8_2) Or EurJpyEMA8_3 = "" Or IsNothing(EurJpyEMA8_3) Then
                EurJpyTrendEMA = ""
                Exit Sub
            End If

            If CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA8_2) And Math.Abs(CDbl(Replace(EurJpyEMA8_1, ".", "")) - CDbl(Replace(EurJpyEMA8_2, ".", ""))) >= 3 Then
                EurJpyEMA8 = "UP"
            ElseIf CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA8_2) And Math.Abs(CDbl(Replace(EurJpyEMA8_2, ".", "")) - CDbl(Replace(EurJpyEMA8_1, ".", ""))) >= 3 Then
                EurJpyEMA8 = "DOWN"
            End If

            If CDbl(EurJpyPosDMI_1) > CDbl(EurJpyPosDMI_2) Then
                posEurJpyDMI = "UP"
            Else
                posEurJpyDMI = "DOWN"
            End If
            If CDbl(EurJpyNegDMI_1) > CDbl(EurJpyNegDMI_2) Then
                NegEurJpyDMI = "UP"
            Else
                NegEurJpyDMI = "DOWN"
            End If


            If CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA8_2) And CDbl(EurJpyEMA8_2) > CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA21_1) Then
                EurJpyTrendEMA = "UP"
            End If
            If CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA8_2) And CDbl(EurJpyEMA8_2) > CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA21_1) And CDbl(EurJpyEMA21_1) > CDbl(EurJpyEMA55_1) Then
                EurJpyTrendEMA = "GOUP"
            End If
            If CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA8_2) And CDbl(EurJpyEMA8_2) < CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA21_1) Then
                EurJpyTrendEMA = "DOWN"
            End If
            If CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA8_2) And CDbl(EurJpyEMA8_2) < CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA21_1) And CDbl(EurJpyEMA21_1) < CDbl(EurJpyEMA55_1) Then
                EurJpyTrendEMA = "GODOWN"
            End If

            If (CDbl(EurJpyADX_1) > CDbl(EurJpyADX_2) And CDbl(EurJpyADX_2) >= CDbl(EurJpyADX_3)) Then 'And CDbl(EurJpyADX_1) >= 15 Then  'And ADX_2 > ADX_3 And ADX_1 >= 20 Then
                EurJpyADXTrend = "STRONG"
            Else
                EurJpyADXTrend = "NEUTRAL"
            End If

            NegEurJpyCrossDMI = ""
            PosEurJpyCrossDMI = ""

            'If CDbl(EurJpyPosDMI_1) > CDbl(EurJpyPosDMI_2) And CDbl(EurJpyNegDMI_1) < CDbl(EurJpyNegDMI_2) And CDbl(EurJpyPosDMI_2) < CDbl(EurJpyNegDMI_2) And CDbl(EurJpyPosDMI_1) > CDbl(EurJpyNegDMI_1) Then
            If posEurJpyDMI = "UP" And NegEurJpyDMI = "DOWN" And CDbl(EurJpyPosDMI_1) > CDbl(EurJpyNegDMI_1) Then
                PosEurJpyCrossDMI = "PosDMICROSSUP"
                NegEurJpyCrossDMI = ""
            End If
            'If CDbl(EurJpyNegDMI_1) > CDbl(EurJpyNegDMI_2) And CDbl(EurJpyPosDMI_1) < CDbl(EurJpyPosDMI_2) And CDbl(EurJpyNegDMI_2) < CDbl(EurJpyPosDMI_2) And CDbl(EurJpyNegDMI_1) > CDbl(EurJpyPosDMI_1) Then
            If posEurJpyDMI = "DOWN" And NegEurJpyDMI = "UP" And CDbl(EurJpyNegDMI_1) > CDbl(EurJpyPosDMI_1) Then
                NegEurJpyCrossDMI = "NegDMICROSSUP"
                PosEurJpyCrossDMI = ""
            End If


            If EurJpyRSI_1 > EurJpyRSI_2 And EurJpyRSI_1 <= 72 Then
                EurJpyRSITrend = "UP"
            ElseIf EurJpyRSI_1 > 72 Then
                EurJpyRSITrend = "OB"
            ElseIf EurJpyRSI_1 < EurJpyRSI_2 And EurJpyRSI_1 >= 30 Then
                EurJpyRSITrend = "DOWN"
            ElseIf EurJpyRSI_1 < 28 Then
                EurJpyRSITrend = "OS"
            Else
                EurJpyRSITrend = "NEUTRAL"
            End If

            If CDbl(EurJpyMacdVal_1) > CDbl(EurJpyMacdSignal_1) And CDbl(EurJpyMacdVal_2) > CDbl(EurJpyMacdSignal_2) And (CDbl(EurJpyMacdVal_1) > CDbl(EurJpyMacdVal_2) And CDbl(EurJpyMacdSignal_1) > CDbl(EurJpyMacdSignal_2)) And Math.Abs(CDbl(EurJpyMacdVal_1) - CDbl(EurJpyMacdVal_2)) > 1 Then 'And macdVal_3 > macdSignal_3 Then
                EurJpyMACDTrend = "UP"
            ElseIf CDbl(EurJpyMacdVal_1) < CDbl(EurJpyMacdSignal_1) And CDbl(EurJpyMacdVal_2) < CDbl(EurJpyMacdSignal_2) And (CDbl(EurJpyMacdVal_1) < CDbl(EurJpyMacdVal_2) And CDbl(EurJpyMacdSignal_1) < CDbl(EurJpyMacdSignal_2)) And Math.Abs(CDbl(EurJpyMacdVal_1) - CDbl(EurJpyMacdVal_2)) > 1 Then 'And macdVal_3 < macdSignal_3 Then
                EurJpyMACDTrend = "DOWN"
            ElseIf CDbl(EurJpyMacdVal_1) > CDbl(EurJpyMacdSignal_1) And CDbl(EurJpyMacdVal_2) > CDbl(EurJpyMacdSignal_2) And (CDbl(EurJpyMacdVal_1) > CDbl(EurJpyMacdVal_2) And CDbl(EurJpyMacdSignal_1) > CDbl(EurJpyMacdSignal_2)) And Math.Abs(CDbl(EurJpyMacdVal_1) - CDbl(EurJpyMacdVal_2)) = 1 Then
                EurJpyMACDTrend = "SOFTNEUTRAL"
            ElseIf CDbl(EurJpyMacdVal_1) < CDbl(EurJpyMacdSignal_1) And CDbl(EurJpyMacdVal_2) < CDbl(EurJpyMacdSignal_2) And (CDbl(EurJpyMacdVal_1) < CDbl(EurJpyMacdVal_2) And CDbl(EurJpyMacdSignal_1) < CDbl(EurJpyMacdSignal_2)) And Math.Abs(CDbl(EurJpyMacdVal_1) - CDbl(EurJpyMacdVal_2)) = 1 Then 'And macdVal_3 < macdSignal_3 Then
                EurJpyMACDTrend = "SOFTNEUTRAL"
            Else
                EurJpyMACDTrend = "NEUTRAL"
            End If

            If CDbl(EurJpyEMA8_1) > CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_3) < CDbl(reader("EMA21")) And CDbl(EurJpyEMA8_1) >= CDbl(reader("EMA21")) Then 'And CDbl(reader("EMA21")) > CDbl(reader("EMA55")) Then
                EurJpyTrendEMA = "UPEMA"
            End If
            If CDbl(EurJpyEMA8_1) < CDbl(EurJpyEMA8_3) And CDbl(EurJpyEMA8_1) <= CDbl(reader("EMA21")) And CDbl(EurJpyEMA8_3) > CDbl(reader("EMA21")) Then 'And CDbl(reader("EMA21")) < CDbl(reader("EMA55")) Then
                EurJpyTrendEMA = "DOWNEMA"
            End If
            If CDbl(EurJpyEMA21_1) > CDbl(EurJpyEMA21_3) And CDbl(EurJpyEMA21_1) >= CDbl(reader("EMA55")) And CDbl(EurJpyEMA21_3) < CDbl(reader("EMA55")) Then
                EurJpyTrendEMA = "LONGUPEMA"
            End If
            If CDbl(EurJpyEMA21_1) < CDbl(EurJpyEMA21_3) And CDbl(EurJpyEMA21_1) <= CDbl(reader("EMA55")) And CDbl(EurJpyEMA21_3) > CDbl(reader("EMA55")) Then
                EurJpyTrendEMA = "LONGDOWNEMA"
            End If

        Catch ex As Exception
            HttpContext.Current.Response.Write(ex.Message)
        Finally
            reader.Close()
            opExec.closeConnection()
        End Try

    End Sub


    Public Sub TrendEURCHF()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        NegEURCHFDMI = ""
        PosEURCHFDMI = ""

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from study where curr = 'EURCHF' order by TimeNow DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                'IDENTIFICATION EMA8_1
                EURCHFEMA8_1 = reader("EMA8")
                EurChfEMA21_1 = reader("EMA21")
                EurChfEMA55_1 = reader("EMA55")
                EurChfPosDMI_1 = reader("PosDMI")
                EurChfNegDMI_1 = reader("NegDMI")

                'IDENTIFICATION ADX_1
                EurChfADX_1 = reader("ADX")

                'IDENTIFICATION RSI_1
                EurChfRSI_1 = reader("RSI")

                'IDENTIFICATION macd_1
                EurChfMacdVal_1 = reader("MACDValue")
                EurChfMacdSignal_1 = reader("MACDSignal")

                reader.Read()

                EURCHFEMA8_2 = reader("EMA8")
                EurChfEMA21_2 = reader("EMA21")
                EurChfPosDMI_2 = reader("PosDMI")
                EurChfNegDMI_2 = reader("NegDMI")

                'IDENTIFICATION ADX_2
                EurChfADX_2 = reader("ADX")
                'IDENTIFICATION RSI_2
                EurChfRSI_2 = reader("RSI")

                'IDENTIFICATION macd_2
                EurChfMacdVal_2 = reader("MACDValue")
                EurChfMacdSignal_2 = reader("MACDSignal")


                reader.Read()

                EURCHFEMA8_3 = reader("EMA8")
                EurChfEMA21_3 = reader("EMA21")

                'IDENTIFICATION ADX_3
                EurChfADX_3 = reader("ADX")

                'IDENTIFICATION RSI_3
                EurChfRSI_3 = reader("RSI")

                'IDENTIFICATION macd_3
                'macdVal_3 = reader("MACDValue")
                'macdSignal_3 = reader("MACDSignal")

            End If

            'Identyfying variables

            If EURCHFEMA8_1 = "" Or IsNothing(EURCHFEMA8_1) Or EURCHFEMA8_2 = "" Or IsNothing(EURCHFEMA8_2) Or EURCHFEMA8_3 = "" Or IsNothing(EURCHFEMA8_3) Then
                EURCHFTrendEMA = ""
                Exit Sub
            End If

            If CDbl(EURCHFEMA8_1) > CDbl(EURCHFEMA8_2) And Math.Abs(CDbl(Replace(EURCHFEMA8_1, ".", "")) - CDbl(Replace(EURCHFEMA8_2, ".", ""))) >= 3 Then
                EURCHFEMA8 = "UP"
            ElseIf CDbl(EURCHFEMA8_1) < CDbl(EURCHFEMA8_2) And Math.Abs(CDbl(Replace(EURCHFEMA8_2, ".", "")) - CDbl(Replace(EURCHFEMA8_1, ".", ""))) >= 3 Then
                EURCHFEMA8 = "DOWN"
            End If


            If CDbl(EurChfPosDMI_1) > CDbl(EurChfPosDMI_2) Then
                PosEURCHFDMI = "UP"
            Else
                PosEURCHFDMI = "DOWN"
            End If
            If CDbl(EurChfNegDMI_1) > CDbl(EurChfNegDMI_2) Then
                NegEURCHFDMI = "UP"
            Else
                NegEURCHFDMI = "DOWN"
            End If


            If CDbl(EURCHFEMA8_1) > CDbl(EURCHFEMA8_2) And CDbl(EURCHFEMA8_2) > CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_1) > CDbl(EurChfEMA21_1) Then
                EURCHFTrendEMA = "UP"
            End If
            If CDbl(EURCHFEMA8_1) > CDbl(EURCHFEMA8_2) And CDbl(EURCHFEMA8_2) > CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_1) > CDbl(EurChfEMA21_1) And CDbl(EurChfEMA21_1) > CDbl(EurChfEMA55_1) Then
                EURCHFTrendEMA = "GOUP"
            End If
            If CDbl(EURCHFEMA8_1) < CDbl(EURCHFEMA8_2) And CDbl(EURCHFEMA8_2) < CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_1) < CDbl(EurChfEMA21_1) Then
                EURCHFTrendEMA = "DOWN"
            End If
            If CDbl(EURCHFEMA8_1) < CDbl(EURCHFEMA8_2) And CDbl(EURCHFEMA8_2) < CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_1) < CDbl(EurChfEMA21_1) And CDbl(EurChfEMA21_1) < CDbl(EurChfEMA55_1) Then
                EURCHFTrendEMA = "GODOWN"
            End If

            If (CDbl(EurChfADX_1) > CDbl(EurChfADX_2) And CDbl(EurChfADX_2) >= CDbl(EurChfADX_3)) Then 'And CDbl(EurChfADX_1) >= 15) Then 'And ADX_2 > ADX_3 And ADX_1 >= 20 Then
                EurChfADXTrend = "STRONG"
            Else
                EurChfADXTrend = "NEUTRAL"
            End If

            NegEurChfCrossDMI = ""
            PosEurChfCrossDMI = ""

            'If CDbl(EURCHFPosDMI_1) > CDbl(EURCHFPosDMI_2) And CDbl(EURCHFNegDMI_1) < CDbl(EURCHFNegDMI_2) And CDbl(EURCHFPosDMI_2) < CDbl(EURCHFNegDMI_2) And CDbl(EURCHFPosDMI_1) > CDbl(EURCHFNegDMI_1) Then
            If PosEURCHFDMI = "UP" And NegEURCHFDMI = "DOWN" And CDbl(EurChfPosDMI_1) > CDbl(EurChfNegDMI_1) Then
                PosEurChfCrossDMI = "PosDMICROSSUP"
                NegEurChfCrossDMI = ""
            End If
            'If CDbl(EURCHFNegDMI_1) > CDbl(EURCHFNegDMI_2) And CDbl(EURCHFPosDMI_1) < CDbl(EURCHFPosDMI_2) And CDbl(EURCHFNegDMI_2) < CDbl(EURCHFPosDMI_2) And CDbl(EURCHFNegDMI_1) > CDbl(EURCHFPosDMI_1) Then
            If PosEURCHFDMI = "DOWN" And NegEURCHFDMI = "UP" And CDbl(EurChfNegDMI_1) > CDbl(EurChfPosDMI_1) Then
                NegEurChfCrossDMI = "NegDMICROSSUP"
                PosEurChfCrossDMI = ""
            End If


            If EurChfRSI_1 > EurChfRSI_2 And EurChfRSI_1 <= 72 Then
                EurChfRSITrend = "UP"
            ElseIf EurChfRSI_1 > 72 Then
                EurChfRSITrend = "OB"
            ElseIf EurChfRSI_1 < EurChfRSI_2 And EurChfRSI_1 >= 30 Then
                EurChfRSITrend = "DOWN"
            ElseIf EurChfRSI_1 < 28 Then
                EurChfRSITrend = "OS"
            Else
                EurChfRSITrend = "NEUTRAL"
            End If

            If CDbl(EurChfMacdVal_1) > CDbl(EurChfMacdSignal_1) And CDbl(EurChfMacdVal_2) > CDbl(EurChfMacdSignal_2) And (CDbl(EurChfMacdVal_1) > CDbl(EurChfMacdVal_2) And CDbl(EurChfMacdSignal_1) > CDbl(EurChfMacdSignal_2)) And Math.Abs(CDbl(EurChfMacdVal_1) - CDbl(EurChfMacdVal_2)) > 1 Then 'And macdVal_3 > macdSignal_3 Then
                EurChfMACDTrend = "UP"
            ElseIf CDbl(EurChfMacdVal_1) < CDbl(EurChfMacdSignal_1) And CDbl(EurChfMacdVal_2) < CDbl(EurChfMacdSignal_2) And (CDbl(EurChfMacdVal_1) < CDbl(EurChfMacdVal_2) And CDbl(EurChfMacdSignal_1) < CDbl(EurChfMacdSignal_2)) And Math.Abs(CDbl(EurChfMacdVal_1) - CDbl(EurChfMacdVal_2)) > 1 Then 'And macdVal_3 < macdSignal_3 Then
                EurChfMACDTrend = "DOWN"
            ElseIf CDbl(EurChfMacdVal_1) > CDbl(EurChfMacdSignal_1) And CDbl(EurChfMacdVal_2) > CDbl(EurChfMacdSignal_2) And (CDbl(EurChfMacdVal_1) > CDbl(EurChfMacdVal_2) And CDbl(EurChfMacdSignal_1) > CDbl(EurChfMacdSignal_2)) And Math.Abs(CDbl(EurChfMacdVal_1) - CDbl(EurChfMacdVal_2)) = 1 Then
                EurChfMACDTrend = "SOFTNEUTRAL"
            ElseIf CDbl(EurChfMacdVal_1) < CDbl(EurChfMacdSignal_1) And CDbl(EurChfMacdVal_2) < CDbl(EurChfMacdSignal_2) And (CDbl(EurChfMacdVal_1) < CDbl(EurChfMacdVal_2) And CDbl(EurChfMacdSignal_1) < CDbl(EurChfMacdSignal_2)) And Math.Abs(CDbl(EurChfMacdVal_1) - CDbl(EurChfMacdVal_2)) = 1 Then 'And macdVal_3 < macdSignal_3 Then
                EurChfMACDTrend = "SOFTNEUTRAL"
            Else
                EurChfMACDTrend = "NEUTRAL"
            End If

            If CDbl(EURCHFEMA8_1) > CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_3) < CDbl(reader("EMA21")) And CDbl(EURCHFEMA8_1) >= CDbl(reader("EMA21")) Then
                EURCHFTrendEMA = "UPEMA"
            End If
            If CDbl(EURCHFEMA8_1) < CDbl(EURCHFEMA8_3) And CDbl(EURCHFEMA8_1) <= CDbl(reader("EMA21")) And CDbl(EURCHFEMA8_3) > CDbl(reader("EMA21")) Then
                EURCHFTrendEMA = "DOWNEMA"
            End If
            If CDbl(EurChfEMA21_1) > CDbl(EurChfEMA21_3) And CDbl(EurChfEMA21_1) >= CDbl(reader("EMA55")) And CDbl(EurChfEMA21_3) < CDbl(reader("EMA55")) Then
                EURCHFTrendEMA = "LONGUPEMA"
            End If
            If CDbl(EurChfEMA21_1) < CDbl(EurChfEMA21_3) And CDbl(EurChfEMA21_1) <= CDbl(reader("EMA55")) And CDbl(EurChfEMA21_3) > CDbl(reader("EMA55")) Then
                EURCHFTrendEMA = "LONGDOWNEMA"
            End If

        Catch ex As Exception
            HttpContext.Current.Response.Write(ex.Message)
        Finally
            reader.Close()
            opExec.closeConnection()
        End Try

    End Sub


    Public Sub TrendGbpJpy()

        Dim conn As cs_Connection
        Dim opExec As cs_Operation
        Dim strLink As String

        NegGbpJpyDMI = ""
        posGbpJpyDMI = ""

        opExec = New cs_Operation
        Dim reader As OleDbDataReader = opExec.rdGetReader("select top 3 * from study where curr = 'GBPJPY' order by TimeNow DESC ")

        Try

            If reader.HasRows = True Then
                reader.Read()

                'IDENTIFICATION EMA8_1
                GBPJPYEMA8_1 = reader("EMA8")
                GbpJpyEMA21_1 = reader("EMA21")
                GbpJpyEMA55_1 = reader("EMA55")
                GbpJpyPosDMI_1 = reader("PosDMI")
                GbpJpyNegDMI_1 = reader("NegDMI")

                'IDENTIFICATION ADX_1
