                GBPJPYEMA8_2 = reader("EMA8")
                GbpJpyEMA21_2 = reader("EMA21")
                GbpJpyPosDMI_2 = reader("PosDMI")
                GbpJpyNegDMI_2 = reader("NegDMI")

