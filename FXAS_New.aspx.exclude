        </td>
        <td>
            
            
            <asp:TextBox ID="txtOpenedPips" Width=60 CssClass="INPUTTEXTRED" runat="server" />
        
        
        </td>
         <td>
            <asp:Label ID="Label4" runat="server" CssClass="BlackTextBold" Text="UsblMarg"></asp:Label>
         
         
