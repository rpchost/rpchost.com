                            <asp:RequiredFieldValidator ID="ReqAccID" runat="server" 
                                ControlToValidate="txtUserName">*</asp:RequiredFieldValidator>
        
            </td>
            
              <td Class="BlackTextBold" >
                Connection
            </td>
            
