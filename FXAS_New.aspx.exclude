            <anthem:Timer ID="Timer2" Interval=5000 Enabled=true runat="server">
            </anthem:Timer>
          
        <asp:GridView ID="GridView1" CssClass="aspGridView" Width=100%  runat="server">
            <Columns>
            
                        
                        
                
            
                        
<asp:TemplateField HeaderText="">
        <ItemTemplate>
                <asp:Button ID="deleteButton" runat="server" CssClass="inputbuttonnew" Width=50 Height=20 CommandName="Select" Text="Close"
