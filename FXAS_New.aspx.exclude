                                <asp:DropDownList CssClass="inputtext" ID="cmbConnection" runat="server">
                                <asp:ListItem Value="demo">Demo</asp:ListItem>
                                <asp:ListItem Value="real">Real</asp:ListItem>
                                </asp:DropDownList>
        
            </td>
            
            
             <td>
                 
                

        
