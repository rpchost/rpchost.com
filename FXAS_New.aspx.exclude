            <td>
                            <asp:TextBox ID="txtRpcUserID" CssClass="inputtext" Width=50 runat="server">46</asp:TextBox>
        
                            <asp:RequiredFieldValidator ID="ReqUserID" runat="server" 
                                ControlToValidate="txtRpcUserID">*</asp:RequiredFieldValidator>
        
            </td>
            
              <td Class="BlackTextBold" >
                Pwd
            </td>
            
            <td>
                                
                    <asp:TextBox ID="txtRpcPwd" CssClass="inputtext" Width=60  runat="server" 
                        >jijo1136</asp:TextBox>
            </td>
            
            
             <td>
                 
                
                 <asp:RequiredFieldValidator ID="ReqPwd" runat="server" 
                     ControlToValidate="txtRpcPwd">*</asp:RequiredFieldValidator>
                 
                
            </td>
            
            
        </tr>
        
        
          <tr>
            <td colspan=4 Class="BlueText" height=40>
